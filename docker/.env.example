# Production settings for docker/compose.production.yaml.
# Copy it next to itself, then fill in the three values:
#
#   cp docker/.env.example docker/.env && chmod 600 docker/.env
#
# Compose reads docker/.env on every `docker compose -f
# docker/compose.production.yaml` command. Git and image builds ignore it.
#
# Coming from the previous version's .env:
#   CORS_ORIGINS   -> PUBLIC_URL (one https address)
#   FRONTEND_PORT  -> APP_PORT (still 80 by default)
#   DB_PATH        -> gone: the data moves to Postgres (POSTGRES_PASSWORD)
#   VITE_API_URL, BACKEND_PORT, HOST -> gone: one container serves the
#                     site and the API on one port
#   TZ             -> new: the team's time zone

# The https address people type to open the site. Required: the app refuses
# to start with an http one.
PUBLIC_URL=https://booking.example.com

# The password of the new Postgres database. Pick it once and never change
# it: the database keeps the first one. Letters and digits only, such as the
# output of `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# The team's time zone: a booking ends at midnight in this zone.
TZ=Europe/Paris

# The port on this machine, where your HTTPS proxy sends requests. Same as
# before; change it only if 80 is taken.
# APP_PORT=80

# Google Analytics 4's measurement id, such as G-XXXXXXXXXX (README,
# "Analytics"). Leave it out and there is none: no script, no cookie banner.
# GA_MEASUREMENT_ID=

# Nothing else is needed: sign-in stays off, as before.
