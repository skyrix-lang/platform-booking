# Development settings: `yarn setup` copies this to .env, with a random
# SESSION_SECRET. For production, see docker/.env.example instead.

# The address people use, https in production. The CSRF check, canonical URLs,
# the sitemap and the OIDC callback are built from it. In development it's the
# Vite dev server.
PUBLIC_URL=http://localhost:3000

# Ports in development: Vite (WEB_PORT) forwards /api and /auth to the BFF
# (PORT). `yarn setup` sets both in a git worktree, so checkouts can run side by
# side; update PUBLIC_URL with WEB_PORT. In Docker, PORT is the container's port.
# WEB_PORT=3000
# PORT=3001

# The least severe level the BFF logs: debug, info, warn, error or silent.
# Lines are JSON when NODE_ENV=production (as in the image), text otherwise.
# LOG_LEVEL=info

# Postgres connection, matching `yarn db:up`.
DATABASE_URL=postgres://platform_booking:platform_booking@localhost:5432/platform_booking

# The time zone whose "today" ends bookings (end dates, expiry). Unset, it's
# this machine's zone.
# TZ=Europe/Paris

# Sign-in is off in production: the site is open. The four settings below
# turn it on in development only, against the local Keycloak from
# `yarn keycloak:up` (users ada / ada and grace / grace), so the e2e tests can
# check that sign-in stays safe. Leave them unset to turn it off.

# Signs the short-lived sign-in cookie: at least 32 random characters.
SESSION_SECRET=change-me

# The identity provider: any OpenID Connect provider, with a confidential
# client whose redirect URI is ${PUBLIC_URL}/auth/callback.
OIDC_ISSUER=http://localhost:8180/realms/platform-booking
OIDC_CLIENT_ID=platform-booking-web
OIDC_CLIENT_SECRET=platform-booking-web-dev-secret

# Mail (apps/bff/src/mail.ts). Leave SMTP_HOST unset and mail is only logged,
# never sent: tests always run that way. For Scaleway Transactional Email, the
# user is the project ID and the password an API secret key, and MAIL_FROM
# must be on a domain verified there. Port 465 or 2465 uses TLS from the
# start; 587, 2587 or 25 must upgrade with STARTTLS.
# SMTP_HOST=smtp.tem.scaleway.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Platform Booking <no-reply@example.com>"

# Google Analytics 4 (README, "Analytics"). Unset, there is none: no script, no
# consent banner, nothing added to the CSP. Set, visitors are asked first, and
# Google's library loads only for those who accept.
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Production (.env.production on the server, readable by its owner only; see
# "Deploying" in the README). The values above, for production, plus the
# proxy's: docker/compose.production.yaml runs behind nginx-proxy and its
# Let's Encrypt companion. DATABASE_URL then names the shared Postgres on the
# proxy's network, e.g. postgres://<user>:<password>@postgres:5432/<database>.
# The backups' R2 key goes in a separate backup.env, never here
# (docker/backup.env.example).
# VIRTUAL_HOST=app.example.com
# VIRTUAL_PORT=3000
# LETSENCRYPT_HOST=app.example.com
# LETSENCRYPT_EMAIL=you@example.com
