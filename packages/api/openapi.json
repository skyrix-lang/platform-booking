{
  "openapi": "3.1.0",
  "info": {
    "title": "Platform Booking API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "email",
              "name"
            ]
          }
        },
        "required": [
          "user"
        ]
      },
      "Platform": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kubernetes": {
            "type": "boolean"
          },
          "nightly": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "description",
          "kubernetes",
          "nightly"
        ]
      },
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "error"
        ]
      },
      "CreatePlatform": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "maxLength": 200,
            "default": ""
          },
          "kubernetes": {
            "type": "boolean",
            "default": false
          },
          "nightly": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id"
        ]
      },
      "UpdatePlatform": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 200,
            "default": ""
          },
          "kubernetes": {
            "type": "boolean",
            "default": false
          },
          "nightly": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Booking": {
        "type": "object",
        "properties": {
          "platformId": {
            "type": "string"
          },
          "trigram": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "bookedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "platformId",
          "trigram",
          "startDate",
          "endDate",
          "bookedAt"
        ]
      },
      "BookingHistoryEntry": {
        "type": "object",
        "properties": {
          "platformId": {
            "type": "string"
          },
          "trigram": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "bookedAt": {
            "type": "string",
            "format": "date-time"
          },
          "releasedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "$ref": "#/components/schemas/HistoryReason"
          }
        },
        "required": [
          "platformId",
          "trigram",
          "startDate",
          "endDate",
          "bookedAt",
          "releasedAt",
          "reason"
        ]
      },
      "HistoryReason": {
        "type": "string",
        "enum": [
          "released",
          "expired"
        ]
      },
      "CreateBooking": {
        "type": "object",
        "properties": {
          "platformId": {
            "type": "string",
            "minLength": 1
          },
          "trigram": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "platformId",
          "trigram",
          "endDate"
        ]
      },
      "UpdateBooking": {
        "type": "object",
        "properties": {
          "endDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "endDate"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The database answers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "It doesn't",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unavailable"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "The signed-in user, or null",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          }
        }
      }
    },
    "/api/platforms": {
      "get": {
        "operationId": "listPlatforms",
        "responses": {
          "200": {
            "description": "Every platform, by id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Platform"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPlatform",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePlatform"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new platform",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Platform"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "A platform with this id already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/platforms/{id}": {
      "put": {
        "operationId": "updatePlatform",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePlatform"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated platform",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Platform"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such platform",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePlatform",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted; its bookings are released"
          },
          "404": {
            "description": "No such platform",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "operationId": "listBookings",
        "responses": {
          "200": {
            "description": "The active bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createBooking",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBooking"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new booking, from today",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, an end date in the past, or past today on a nightly platform",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such platform",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "This trigram has already booked this platform",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/history": {
      "get": {
        "operationId": "listBookingHistory",
        "responses": {
          "200": {
            "description": "Bookings that ended in the last three weeks, the most recent first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookingHistoryEntry"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{platformId}/{trigram}": {
      "patch": {
        "operationId": "updateBooking",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "platformId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "trigram",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBooking"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The booking with its new end date",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, an end date in the past, or past today on a nightly platform",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such booking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "releaseBooking",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "platformId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "trigram",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Done"
          },
          "404": {
            "description": "No such booking",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
