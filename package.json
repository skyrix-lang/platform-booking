{
  "name": "platform-booking",
  "private": true,
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach -Api run dev",
    "build": "yarn workspaces foreach -Api run build",
    "check": "yarn workspaces foreach -Api run check",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:prod": "docker-compose up --build",
    "docker:prod:down": "docker-compose down",
    "docker:build": "docker build -f docker/production.Dockerfile -t platform-booking:latest .",
    "docker:run": "docker run -p 80:80 -v booking-data:/app/data platform-booking:latest"
  }
}
